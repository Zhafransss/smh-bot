# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smh_ticketing
DB_USER=root
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# WhatsApp
WA_SESSION_PATH=./auth_state
# Folder sementara foto unit dari WhatsApp (dibersihkan otomatis setelah 24 jam)
WA_MEDIA_PATH=./storage/wa_media

# Gmail Alert (gunakan App Password, bukan password biasa)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alert@smh.co.id
SMTP_PASS=your-app-password-here
ALERT_RECIPIENTS=teknisi@smh.co.id

# App
NODE_ENV=development
PORT=3000
TIMEZONE=Asia/Jakarta
CONVERSATION_TTL=86400
DB_SYNC=false

# Security & API
API_KEY=your-secure-api-key-here
CORS_ORIGIN=*

# Chatbot Rate Limiting & Typing Simulation (Anti-ban)
RATE_LIMIT_MAX=10
RATE_LIMIT_DURATION_MS=60000
TYPING_DURATION_MS=10000
MESSAGE_DEBOUNCE_DELAY_MS=3000

# Email Alert Throttling (cooldown window in seconds)
EMAIL_ALERT_THROTTLE_SECONDS=300

# Gemini API — klasifikasi keluhan konsumen ke jenis kerusakan website (real-time, PRD v1.2).
# Gemini hanya memilih ID dari daftar; teks & harga ke konsumen selalu dari database website.
GEMINI_API_KEY=your-gemini-api-key-here
# Beberapa key (opsional): dipakai bergiliran & pindah otomatis bila satu key terkena limit (HTTP 429).
# Pisahkan dengan koma. Jika diisi, GEMINI_API_KEY diabaikan. Kuota Gemini dihitung per PROJECT Google Cloud,
# jadi key dari project yang sama berbagi kuota yang sama.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
# Dipakai otomatis jika model utama timeout / sedang padat / kuota habis (kosongkan untuk mematikan)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=15000

# Groq API (OpenAI-compatible) — cadangan klasifikasi keluhan bila Gemini gagal/limit
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=15000
# Urutan AI provider untuk klasifikasi keluhan (dicoba berurutan, pindah otomatis bila gagal)
CLASSIFIER_PROVIDERS=gemini,groq

# Website SMH (Laravel) public API — dipakai bot untuk daftar jenis kerusakan & reservasi home service
# WEBSITE_API_KEY harus sama dengan API_KEY di .env website (header X-API-KEY)
WEBSITE_API_URL=https://www.selismolishoki.com/api
WEBSITE_API_KEY=
# ID jenis kerusakan "default" di website (dipakai jika keluhan tidak cocok dengan jenis mana pun)
DEFAULT_JENIS_KERUSAKAN_ID=
