# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smh_ticketing
DB_USER=root
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# WhatsApp
WA_SESSION_PATH=./auth_state

# Gmail Alert (gunakan App Password, bukan password biasa)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alert@smh.co.id
SMTP_PASS=your-app-password-here
ALERT_RECIPIENTS=teknisi@smh.co.id

# App
NODE_ENV=development
PORT=3000
TIMEZONE=Asia/Jakarta
CONVERSATION_TTL=86400
DB_SYNC=false

# Security & API
API_KEY=your-secure-api-key-here
CORS_ORIGIN=*

# Chatbot Rate Limiting & Typing Simulation (Anti-ban)
RATE_LIMIT_MAX=10
RATE_LIMIT_DURATION_MS=60000
TYPING_DURATION_MS=10000
MESSAGE_DEBOUNCE_DELAY_MS=3000

# Chatbot Matcher Threshold (Raw Count Minimal Score)
MATCHER_THRESHOLD=2

# Email Alert Throttling (cooldown window in seconds)
EMAIL_ALERT_THROTTLE_SECONDS=300

# Offline Batch Keyword Enrichment (Gemini API - BUKAN untuk jalur chat real-time)
GEMINI_API_KEY=your-gemini-api-key-here
