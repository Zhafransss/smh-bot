{
  "name": "smh-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k -n \"REDIS,APP\" -c \"yellow,cyan\" \"npm run redis\" \"nodemon src/server.js\"",
    "dev:app": "nodemon src/server.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:reset": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "db:create": "npx sequelize-cli db:create",
    "redis": "start-redis.bat"
  },
  "keywords": [
    "whatsapp",
    "chatbot",
    "ticketing",
    "selis",
    "molis",
    "electric-vehicle",
    "smh"
  ],
  "author": "Selis Molis Hoki",
  "license": "ISC",
  "description": "SMH Support - Sistem Chatbot WhatsApp Ticketing & Layanan Servis Sepeda/Motor Listrik Selis Molis Hoki",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bullmq": "^6.3.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
